import { LineEdit, Palette, ScrollView } from "std-widgets.slint";

global Theme {
    property <color> palette-background: Palette.background;
    out property <bool> dark: palette-background.red < 128;

    // Surfaces (Magpie-inspired dark & light palettes)
    out property <color> canvas: dark ? #141416 : #f5f6f8;
    out property <color> inset: dark ? #161619 : #f0f1f4;
    out property <color> surface: dark ? #1c1c1f : #ffffff;
    out property <color> control: dark ? #222226 : #f8f9fb;
    out property <color> hover: dark ? #242429 : #eceef2;
    out property <color> selected: dark ? #2a2a31 : #e6e8ee;

    // Segmented control track & active pill (matches Magpie screenshot 2 & 3)
    out property <color> seg-track: dark ? #151518 : #ecedf1;
    out property <color> seg-pill: dark ? #2d2d35 : #ffffff;
    out property <color> seg-pill-border: dark ? #3b3b45 : #dcdfe6;

    // Borders
    out property <color> line: dark ? #26262b : #e6e8ee;
    out property <color> outline: dark ? #34343d : #d4d7e0;
    out property <color> outline-hover: dark ? #4a4a56 : #b8bdc9;

    // Typography
    out property <color> text: dark ? #ececef : #18191d;
    out property <color> secondary: dark ? #93939e : #525660;
    out property <color> muted: dark ? #6b6b75 : #7b808c;

    // Semantic colors
    out property <color> positive: dark ? #34d399 : #0c8a5e;
    out property <color> warning: dark ? #fbbf24 : #9a5b00;
    out property <color> warning-bg: dark ? #382e1a : #fef0cf;
    out property <color> warning-bg-hover: dark ? #473a1f : #fde5ad;
    out property <color> negative: dark ? #f87171 : #c9333a;
    out property <color> close-hover: #e5484d;
    out property <color> link: dark ? #60a5fa : #2563eb;
    out property <color> primary: dark ? #e4e4e8 : #18191d;
    out property <color> primary-hover: dark ? #ffffff : #2d3038;
    out property <color> primary-fg: dark ? #141416 : #ffffff;
}

export struct AgentItem {
    id: string,
    name: string,
    glyph: string,
    badge-bg: color,
    badge-fg: color,
    version: string,
    installed: bool,
    running-count: int,
    is-electron: bool,
    status-text: string,
    executable-path: string,
    source: string,
    cli-command: string,
    proxy-index: int,
    expanded: bool,
}

export struct ProxyItem {
    id: string,
    name: string,
    url: string,
    bypass: string,
    is-default: bool,
    reachable: bool,
    status-detail: string,
    deletable: bool,
}

/// Crisp vector circle dot.
component StatusDot inherits Rectangle {
    in property <color> dot-color: Theme.positive;
    in property <length> dot-size: 7px;

    width: dot-size;
    height: dot-size;
    border-radius: dot-size / 2;
    background: dot-color;
}

/// Crisp vector chevron icon (`dir`: 0 = right, 1 = down, 2 = up).
component ChevronIcon inherits Rectangle {
    in property <int> dir: 0;
    in property <color> stroke-color: Theme.secondary;

    width: 10px;
    height: 10px;
    background: transparent;

    if dir == 0 : Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        stroke: root.stroke-color;
        stroke-width: 1.4px;
        stroke-line-cap: round;
        stroke-line-join: round;
        MoveTo { x: 3.5; y: 2; }
        LineTo { x: 6.8; y: 5; }
        LineTo { x: 3.5; y: 8; }
    }

    if dir == 1 : Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        stroke: root.stroke-color;
        stroke-width: 1.4px;
        stroke-line-cap: round;
        stroke-line-join: round;
        MoveTo { x: 2; y: 3.5; }
        LineTo { x: 5; y: 6.8; }
        LineTo { x: 8; y: 3.5; }
    }

    if dir == 2 : Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        stroke: root.stroke-color;
        stroke-width: 1.4px;
        stroke-line-cap: round;
        stroke-line-join: round;
        MoveTo { x: 2; y: 6.8; }
        LineTo { x: 5; y: 3.5; }
        LineTo { x: 8; y: 6.8; }
    }
}

/// Window caption button (minimize / maximize / close) for merged titlebar.
component CaptionButton inherits Rectangle {
    in property <int> kind: 0; // 0 = min, 1 = max/restore, 2 = close
    in property <bool> is-maximized: false;
    callback clicked();

    width: 38px;
    height: 30px;
    border-radius: 6px;
    background: ta.has-hover ? (kind == 2 ? Theme.close-hover : Theme.hover) : transparent;
    animate background { duration: 100ms; }

    property <color> icon-color: (ta.has-hover && kind == 2) ? #ffffff : Theme.secondary;

    if kind == 0 : Path {
        x: (parent.width - 10px) / 2;
        y: (parent.height - 10px) / 2;
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        stroke: root.icon-color;
        stroke-width: 1.2px;
        stroke-line-cap: round;
        MoveTo { x: 1; y: 5; }
        LineTo { x: 9; y: 5; }
    }

    if kind == 1 : Path {
        x: (parent.width - 10px) / 2;
        y: (parent.height - 10px) / 2;
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        stroke: root.icon-color;
        stroke-width: 1.2px;
        stroke-line-join: round;
        MoveTo { x: 1.5; y: 1.5; }
        LineTo { x: 8.5; y: 1.5; }
        LineTo { x: 8.5; y: 8.5; }
        LineTo { x: 1.5; y: 8.5; }
        Close {}
    }

    if kind == 2 : Path {
        x: (parent.width - 10px) / 2;
        y: (parent.height - 10px) / 2;
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        stroke: root.icon-color;
        stroke-width: 1.3px;
        stroke-line-cap: round;
        MoveTo { x: 1.8; y: 1.8; }
        LineTo { x: 8.2; y: 8.2; }
        MoveTo { x: 8.2; y: 1.8; }
        LineTo { x: 1.8; y: 8.2; }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component NavPill inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    height: 28px;
    min-width: 56px;
    border-radius: 6px;
    background: active ? Theme.selected : (ta.has-hover ? Theme.hover : transparent);
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 13px;
        padding-right: 13px;
        Text {
            text: root.label;
            font-size: 13px;
            font-weight: root.active ? 600 : 400;
            color: root.active ? Theme.text : Theme.secondary;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Magpie-style 3-way segmented selector (`跟随系统 | 浅色 | 深色`).
component SegmentedAppearance inherits Rectangle {
    in-out property <int> current-index: 0;
    callback selected(int);

    height: 30px;
    border-radius: 7px;
    background: Theme.seg-track;
    border-width: 1px;
    border-color: Theme.line;

    HorizontalLayout {
        padding: 3px;
        spacing: 2px;

        for label[idx] in ["跟随系统", "浅色", "深色"] : Rectangle {
            min-width: idx == 0 ? 68px : 46px;
            border-radius: 5px;
            background: root.current-index == idx ? Theme.seg-pill : (seg-ta.has-hover ? Theme.hover : transparent);
            border-width: root.current-index == idx ? 1px : 0px;
            border-color: Theme.seg-pill-border;
            animate background { duration: 120ms; }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                Text {
                    text: label;
                    font-size: 12px;
                    font-weight: root.current-index == idx ? 500 : 400;
                    color: root.current-index == idx ? Theme.text : Theme.secondary;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            seg-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if (root.current-index != idx) {
                        root.current-index = idx;
                        root.selected(idx);
                    }
                }
            }
        }
    }
}

/// Magpie-style 2-way segmented boolean toggle (`关闭 | 开启`).
component SegmentedBoolToggle inherits Rectangle {
    in-out property <bool> checked: true;
    callback toggled(bool);

    width: 98px;
    height: 30px;
    border-radius: 7px;
    background: Theme.seg-track;
    border-width: 1px;
    border-color: Theme.line;

    HorizontalLayout {
        padding: 3px;
        spacing: 2px;

        Rectangle {
            border-radius: 5px;
            background: !root.checked ? Theme.seg-pill : transparent;
            border-width: !root.checked ? 1px : 0px;
            border-color: Theme.seg-pill-border;
            animate background { duration: 120ms; }
            Text {
                text: "关闭";
                font-size: 12px;
                color: !root.checked ? Theme.text : Theme.muted;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if (root.checked) {
                        root.checked = false;
                        root.toggled(false);
                    }
                }
            }
        }

        Rectangle {
            border-radius: 5px;
            background: root.checked ? Theme.seg-pill : transparent;
            border-width: root.checked ? 1px : 0px;
            border-color: Theme.seg-pill-border;
            animate background { duration: 120ms; }
            Text {
                text: "开启";
                font-size: 12px;
                color: root.checked ? Theme.text : Theme.muted;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if (!root.checked) {
                        root.checked = true;
                        root.toggled(true);
                    }
                }
            }
        }
    }
}

/// Clean custom dropdown select — zero ugly white focus ring!
component ProxySelect inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: 0;
    callback selected(int);

    width: 176px;
    height: 30px;
    border-radius: 6px;
    background: ta.has-hover ? Theme.hover : Theme.control;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.outline-hover : Theme.outline;
    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 6px;

        Text {
            text: root.model[root.current-index];
            font-size: 12px;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        VerticalLayout {
            alignment: center;
            ChevronIcon {
                dir: 1;
                stroke-color: Theme.muted;
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.width;

        Rectangle {
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.outline;
            border-radius: 8px;
            drop-shadow-blur: 14px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.dark ? #00000080 : #00000022;

            VerticalLayout {
                padding: 4px;
                spacing: 2px;

                for opt[idx] in root.model : Rectangle {
                    height: 28px;
                    border-radius: 5px;
                    background: opt-ta.has-hover
                        ? Theme.hover
                        : (idx == root.current-index ? Theme.selected : transparent);

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;

                        Text {
                            text: opt;
                            font-size: 12px;
                            font-weight: idx == root.current-index ? 600 : 400;
                            color: idx == root.current-index ? Theme.text : Theme.secondary;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }

                        if idx == root.current-index : VerticalLayout {
                            alignment: center;
                            StatusDot {
                                dot-size: 5px;
                                dot-color: Theme.positive;
                            }
                        }
                    }

                    opt-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.current-index = idx;
                            root.selected(idx);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

component ActionPill inherits Rectangle {
    in property <string> label;
    in property <bool> restart-mode: false;
    callback clicked();

    width: 66px;
    height: 30px;
    border-radius: 15px;
    background: restart-mode
        ? (ta.has-hover ? Theme.warning-bg-hover : Theme.warning-bg)
        : (ta.has-hover ? Theme.primary-hover : Theme.primary);
    animate background { duration: 120ms; }

    Text {
        text: root.label;
        font-size: 12.5px;
        font-weight: 600;
        color: root.restart-mode ? Theme.warning : Theme.primary-fg;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component TextLink inherits Rectangle {
    in property <string> label;
    in property <color> text-color: Theme.secondary;
    in property <color> hover-color: Theme.text;
    in property <int> chevron-dir: -1; // -1 = none, 0 = right, 1 = down, 2 = up
    callback clicked();

    height: 28px;
    border-radius: 5px;
    background: ta.has-hover ? Theme.hover : transparent;
    animate background { duration: 100ms; }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;

        Text {
            text: root.label;
            font-size: 12.5px;
            color: ta.has-hover ? root.hover-color : root.text-color;
            vertical-alignment: center;
        }

        if root.chevron-dir >= 0 : VerticalLayout {
            alignment: center;
            ChevronIcon {
                dir: root.chevron-dir;
                stroke-color: ta.has-hover ? root.hover-color : root.text-color;
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: "AgentLaunch";
    icon: @image-url("../../../assets/icon.png");
    no-frame: !root.is-macos;
    preferred-width: 880px;
    preferred-height: 580px;
    min-width: 700px;
    min-height: 440px;
    background: Theme.canvas;

    in-out property <int> appearance-index;
    in-out property <ColorScheme> widget-scheme <=> Palette.color-scheme;
    in-out property <bool> is-maximized: false;
    in-out property <bool> is-macos: false;
    callback choose-appearance(int);

    // Frameless window controls
    callback drag-window();
    callback toggle-maximize();
    callback minimize-window();
    callback close-window();
    callback resize-window(int); // 0=N, 1=S, 2=W, 3=E, 4=NW, 5=NE, 6=SW, 7=SE

    // Navigation & status
    in-out property <int> active-tab: 0; // 0 = Agent, 1 = 设置
    in-out property <bool> show-uninstalled: false;
    in-out property <int> uninstalled-count: 0;
    in-out property <bool> show-add-proxy: false;

    in-out property <string> default-proxy-label: "检测中...";
    in-out property <bool> default-proxy-ok: true;
    in-out property <bool> check-proxy-before-launch: true;
    in-out property <string> config-path: "";

    in-out property <string> toast-text: "";
    in-out property <bool> toast-is-error: false;

    // Data models
    in-out property <[AgentItem]> agents: [];
    in-out property <[string]> agent-proxy-choices: [];
    in-out property <[ProxyItem]> proxies: [];

    // New proxy form fields
    in-out property <string> new-proxy-id: "";
    in-out property <string> new-proxy-name: "";
    in-out property <string> new-proxy-url: "http://127.0.0.1:7890";
    in-out property <string> new-proxy-bypass: "localhost;127.0.0.1;::1";

    // Callbacks into Rust core
    callback refresh-all();
    callback launch-agent(string, bool);
    callback select-agent-proxy(string, int);
    callback toggle-agent-details(string);
    callback create-shortcut(string);

    callback test-proxies();
    callback set-default-proxy(string);
    callback update-proxy(string, string, string, string);
    callback delete-proxy(string);
    callback add-proxy(string, string, string, string);
    callback set-check-proxy-before-launch(bool);

    // Outer container: full-canvas background drag + clean edge border
    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.canvas;

        // Background drag area: any empty space around the window can drag it
        TouchArea {
            pointer-event(ev) => {
                if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                    root.drag-window();
                }
            }
        }

        VerticalLayout {
            // === Merged Frameless Titlebar + Navigation Bar (Magpie style) ===
            Rectangle {
                height: 46px;
                background: Theme.canvas;

                // Full-bar drag area behind interactive controls
                TouchArea {
                    pointer-event(ev) => {
                        if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                            root.drag-window();
                        }
                    }
                    double-clicked => { root.toggle-maximize(); }
                }

                HorizontalLayout {
                    padding-left: root.is-macos ? 76px : 16px;
                    padding-right: 8px;
                    alignment: space-between;

                    // Left group: Brand logo + title + Nav pills
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../../../assets/icon.png");
                                width: 20px;
                                height: 20px;
                                image-fit: contain;
                            }
                        }

                        Text {
                            text: "AgentLaunch";
                            font-size: 13.5px;
                            font-weight: 700;
                            color: Theme.text;
                            vertical-alignment: center;
                        }

                        Rectangle { width: 12px; }

                        VerticalLayout {
                            alignment: center;
                            NavPill {
                                label: "Agent";
                                active: root.active-tab == 0;
                                clicked => { root.active-tab = 0; }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            NavPill {
                                label: "设置";
                                active: root.active-tab == 1;
                                clicked => { root.active-tab = 1; }
                            }
                        }
                    }

                    // Right group: Window caption buttons (hidden on macOS which uses native traffic lights)
                    if !root.is-macos : HorizontalLayout {
                        spacing: 2px;
                        alignment: end;

                        VerticalLayout {
                            alignment: center;
                            CaptionButton {
                                kind: 0;
                                clicked => { root.minimize-window(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            CaptionButton {
                                kind: 1;
                                is-maximized: root.is-maximized;
                                clicked => { root.toggle-maximize(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            CaptionButton {
                                kind: 2;
                                clicked => { root.close-window(); }
                            }
                        }
                    }
                }
            }

            // Hairline divider under merged titlebar
            Rectangle {
                height: 1px;
                background: Theme.line;
            }

            // === Main Content: Agent Tab ===
            if root.active-tab == 0 : agent-scroll := ScrollView {
                vertical-stretch: 1;

                Rectangle {
                    min-height: agent-scroll.visible-height;
                    background: transparent;

                    TouchArea {
                        pointer-event(ev) => {
                            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                                root.drag-window();
                            }
                        }
                    }

                    VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    alignment: start;

                    HorizontalLayout {
                        alignment: space-between;
                        spacing: 12px;

                        Text {
                            text: "为每个 Agent 指定独立代理，启动时自动解析最新版本路径并注入参数与环境变量。";
                            font-size: 12.5px;
                            color: Theme.secondary;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }

                        VerticalLayout {
                            alignment: center;
                            TextLink {
                                label: "刷新";
                                clicked => { root.refresh-all(); }
                            }
                        }
                    }

                    // Unified rounded card container (Magpie style)
                    Rectangle {
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.line;
                        border-radius: 10px;
                        clip: true;

                        VerticalLayout {
                            spacing: 0px;

                            for item[idx] in root.agents : VerticalLayout {
                                if item.installed || root.show-uninstalled : VerticalLayout {
                                    if idx > 0 : Rectangle {
                                        height: 1px;
                                        background: Theme.line;
                                    }

                                    Rectangle {
                                        background: row-hover.has-hover ? Theme.hover : transparent;
                                        animate background { duration: 100ms; }

                                        row-hover := TouchArea {}

                                        VerticalLayout {
                                            padding-left: 16px;
                                            padding-right: 16px;
                                            padding-top: 12px;
                                            padding-bottom: 12px;
                                            spacing: 10px;

                                            HorizontalLayout {
                                                spacing: 12px;
                                                alignment: space-between;

                                                // Left: icon badge + title & status subtitle
                                                HorizontalLayout {
                                                    spacing: 12px;
                                                    alignment: start;

                                                    VerticalLayout {
                                                        alignment: center;
                                                        Rectangle {
                                                            width: 34px;
                                                            height: 34px;
                                                            border-radius: 8px;
                                                            background: item.badge-bg;
                                                            Text {
                                                                text: item.glyph;
                                                                font-size: 13.5px;
                                                                font-weight: 700;
                                                                color: item.badge-fg;
                                                                vertical-alignment: center;
                                                                horizontal-alignment: center;
                                                            }
                                                        }
                                                    }

                                                    VerticalLayout {
                                                        spacing: 3px;
                                                        alignment: center;

                                                        HorizontalLayout {
                                                            spacing: 8px;
                                                            alignment: start;
                                                            Text {
                                                                text: item.name;
                                                                font-size: 14px;
                                                                font-weight: 600;
                                                                color: Theme.text;
                                                                vertical-alignment: center;
                                                            }
                                                            if item.version != "" : Text {
                                                                text: item.version;
                                                                font-size: 11.5px;
                                                                color: Theme.muted;
                                                                vertical-alignment: center;
                                                            }
                                                        }

                                                        HorizontalLayout {
                                                            spacing: 6px;
                                                            alignment: start;
                                                            VerticalLayout {
                                                                alignment: center;
                                                                StatusDot {
                                                                    dot-size: 6px;
                                                                    dot-color: (item.installed ? (item.running-count > 0 ? Theme.warning : Theme.positive) : Theme.muted);
                                                                }
                                                            }
                                                            Text {
                                                                text: item.status-text;
                                                                font-size: 11.5px;
                                                                color: (item.installed ? (item.running-count > 0 ? Theme.warning : Theme.positive) : Theme.muted);
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                }

                                                // Right: 详情 + Custom ProxySelect + Single Smart Launch/Restart Pill
                                                HorizontalLayout {
                                                    spacing: 10px;
                                                    alignment: end;

                                                    VerticalLayout {
                                                        alignment: center;
                                                        TextLink {
                                                            label: item.expanded ? "收起" : "详情";
                                                            chevron-dir: item.expanded ? 2 : 0;
                                                            text-color: Theme.secondary;
                                                            clicked => { root.toggle-agent-details(item.id); }
                                                        }
                                                    }

                                                    VerticalLayout {
                                                        alignment: center;
                                                        ProxySelect {
                                                            model: root.agent-proxy-choices;
                                                            current-index: item.proxy-index;
                                                            selected(new-idx) => {
                                                                root.select-agent-proxy(item.id, new-idx);
                                                            }
                                                        }
                                                    }

                                                    if item.installed : VerticalLayout {
                                                        alignment: center;
                                                        ActionPill {
                                                            restart-mode: item.is-electron && item.running-count > 0;
                                                            label: (item.is-electron && item.running-count > 0) ? "重启" : "启动";
                                                            clicked => {
                                                                root.launch-agent(item.id, item.is-electron && item.running-count > 0);
                                                            }
                                                        }
                                                    }

                                                    if !item.installed : VerticalLayout {
                                                        alignment: center;
                                                        Rectangle {
                                                            width: 66px;
                                                            height: 30px;
                                                            Text {
                                                                text: "未安装";
                                                                font-size: 12px;
                                                                color: Theme.muted;
                                                                vertical-alignment: center;
                                                                horizontal-alignment: center;
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            // Expandable details drawer
                                            if item.expanded : Rectangle {
                                                background: Theme.inset;
                                                border-width: 1px;
                                                border-color: Theme.line;
                                                border-radius: 7px;

                                                VerticalLayout {
                                                    padding: 12px;
                                                    spacing: 6px;

                                                    Text {
                                                        text: "路径: " + item.executable-path;
                                                        font-size: 11.5px;
                                                        color: Theme.secondary;
                                                        wrap: word-wrap;
                                                    }
                                                    Text {
                                                        text: "发现方式: " + item.source;
                                                        font-size: 11.5px;
                                                        color: Theme.muted;
                                                    }

                                                    HorizontalLayout {
                                                        alignment: space-between;
                                                        Text {
                                                            text: "CLI: " + item.cli-command;
                                                            font-size: 11.5px;
                                                            color: Theme.link;
                                                            vertical-alignment: center;
                                                        }

                                                        if item.installed : VerticalLayout {
                                                            alignment: center;
                                                            Rectangle {
                                                                height: 26px;
                                                                border-radius: 5px;
                                                                background: sc-ta.has-hover ? Theme.selected : Theme.control;
                                                                border-width: 1px;
                                                                border-color: Theme.outline;

                                                                HorizontalLayout {
                                                                    padding-left: 10px;
                                                                    padding-right: 10px;
                                                                    Text {
                                                                        text: "创建桌面快捷方式";
                                                                        font-size: 11.5px;
                                                                        color: Theme.text;
                                                                        vertical-alignment: center;
                                                                    }
                                                                }

                                                                sc-ta := TouchArea {
                                                                    mouse-cursor: pointer;
                                                                    clicked => { root.create-shortcut(item.id); }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Bottom "显示其余 N 个" footer row
                            if root.uninstalled-count > 0 : VerticalLayout {
                                Rectangle {
                                    height: 1px;
                                    background: Theme.line;
                                }
                                Rectangle {
                                    height: 38px;
                                    background: more-ta.has-hover ? Theme.hover : transparent;
                                    animate background { duration: 100ms; }

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 5px;

                                        Text {
                                            text: root.show-uninstalled
                                                ? "收起未安装"
                                                : ("显示其余 " + root.uninstalled-count + " 个");
                                            font-size: 12px;
                                            color: more-ta.has-hover ? Theme.secondary : Theme.muted;
                                            vertical-alignment: center;
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            ChevronIcon {
                                                dir: root.show-uninstalled ? 2 : 1;
                                                stroke-color: more-ta.has-hover ? Theme.secondary : Theme.muted;
                                            }
                                        }
                                    }

                                    more-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.show-uninstalled = !root.show-uninstalled; }
                                    }
                                }
                            }
                        }
                    }
                    }
                }
            }

            // === Settings Tab (Magpie style) ===
            if root.active-tab == 1 : settings-scroll := ScrollView {
                vertical-stretch: 1;

                Rectangle {
                    min-height: settings-scroll.visible-height;
                    background: transparent;

                    TouchArea {
                        pointer-event(ev) => {
                            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                                root.drag-window();
                            }
                        }
                    }

                    VerticalLayout {
                    padding: 20px;
                    spacing: 10px;
                    alignment: start;

                    // Section 0: 外观 (Magpie segmented pill card)
                    Text {
                        text: "外观";
                        font-size: 12px;
                        color: Theme.muted;
                    }

                    Rectangle {
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.line;
                        border-radius: 10px;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-top: 12px;
                            padding-bottom: 12px;
                            alignment: space-between;

                            Text {
                                text: "主题模式";
                                font-size: 13.5px;
                                color: Theme.text;
                                vertical-alignment: center;
                            }

                            VerticalLayout {
                                alignment: center;
                                SegmentedAppearance {
                                    current-index: root.appearance-index;
                                    selected(idx) => { root.choose-appearance(idx); }
                                }
                            }
                        }
                    }

                    Rectangle { height: 6px; }

                    // Section 1: 代理 (strictly aligned columns!)
                    Text {
                        text: "代理";
                        font-size: 12px;
                        color: Theme.muted;
                    }

                    Rectangle {
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.line;
                        border-radius: 10px;
                        clip: true;

                        VerticalLayout {
                            spacing: 0px;

                            // Card header row
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                padding-top: 10px;
                                padding-bottom: 10px;
                                alignment: space-between;

                                Text {
                                    text: "代理节点";
                                    font-size: 13.5px;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    VerticalLayout {
                                        alignment: center;
                                        TextLink {
                                            label: "测试连通性";
                                            clicked => { root.test-proxies(); }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        TextLink {
                                            label: root.show-add-proxy ? "取消" : "添加代理";
                                            text-color: Theme.text;
                                            clicked => { root.show-add-proxy = !root.show-add-proxy; }
                                        }
                                    }
                                }
                            }

                            // Proxy rows with fixed-width aligned columns
                            for p in root.proxies : VerticalLayout {
                                Rectangle { height: 1px; background: Theme.line; }

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    padding-top: 10px;
                                    padding-bottom: 10px;
                                    spacing: 8px;

                                    VerticalLayout {
                                        alignment: center;
                                        StatusDot {
                                            dot-color: p.reachable ? Theme.positive : Theme.negative;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        p-name := LineEdit {
                                            width: 150px;
                                            height: 30px;
                                            text: p.name;
                                            placeholder-text: "名称";
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        p-url := LineEdit {
                                            height: 30px;
                                            text: p.url;
                                            placeholder-text: "http://127.0.0.1:8118";
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        p-bypass := LineEdit {
                                            width: 156px;
                                            height: 30px;
                                            text: p.bypass;
                                            placeholder-text: "绕过列表";
                                        }
                                    }

                                    // Fixed-width action column so all input boxes above stay razor-aligned
                                    HorizontalLayout {
                                        width: 148px;
                                        spacing: 2px;
                                        alignment: end;

                                        VerticalLayout {
                                            alignment: center;
                                            TextLink {
                                                width: 42px;
                                                label: "保存";
                                                text-color: Theme.link;
                                                clicked => {
                                                    root.update-proxy(p.id, p-name.text, p-url.text, p-bypass.text);
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            if p.is-default : Rectangle {
                                                width: 62px;
                                                height: 28px;
                                                Text {
                                                    text: "默认";
                                                    font-size: 12px;
                                                    color: Theme.positive;
                                                    vertical-alignment: center;
                                                    horizontal-alignment: center;
                                                }
                                            }
                                            if !p.is-default : TextLink {
                                                width: 62px;
                                                label: "设为默认";
                                                clicked => { root.set-default-proxy(p.id); }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            if p.deletable : TextLink {
                                                width: 40px;
                                                label: "删除";
                                                text-color: Theme.negative;
                                                hover-color: Theme.negative;
                                                clicked => { root.delete-proxy(p.id); }
                                            }
                                            if !p.deletable : Rectangle {
                                                width: 40px;
                                                height: 28px;
                                            }
                                        }
                                    }
                                }
                            }

                            // Inline add proxy row (aligned with proxy rows above)
                            if root.show-add-proxy : VerticalLayout {
                                Rectangle { height: 1px; background: Theme.line; }
                                Rectangle {
                                    background: Theme.inset;
                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        padding-top: 10px;
                                        padding-bottom: 10px;
                                        spacing: 8px;

                                        Rectangle { width: 7px; }

                                        VerticalLayout {
                                            alignment: center;
                                            LineEdit {
                                                width: 150px;
                                                height: 30px;
                                                text <=> root.new-proxy-name;
                                                placeholder-text: "名称 (如 Clash)";
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            horizontal-stretch: 1;
                                            LineEdit {
                                                height: 30px;
                                                text <=> root.new-proxy-url;
                                                placeholder-text: "http://127.0.0.1:7890";
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            LineEdit {
                                                width: 156px;
                                                height: 30px;
                                                text <=> root.new-proxy-bypass;
                                                placeholder-text: "绕过列表";
                                            }
                                        }
                                        HorizontalLayout {
                                            width: 148px;
                                            alignment: end;
                                            VerticalLayout {
                                                alignment: center;
                                                TextLink {
                                                    label: "确认添加";
                                                    text-color: Theme.positive;
                                                    clicked => {
                                                        root.add-proxy(
                                                            root.new-proxy-id,
                                                            root.new-proxy-name,
                                                            root.new-proxy-url,
                                                            root.new-proxy-bypass,
                                                        );
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle { height: 6px; }

                    // Section 2: 启动策略
                    Text {
                        text: "启动策略";
                        font-size: 12px;
                        color: Theme.muted;
                    }

                    Rectangle {
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.line;
                        border-radius: 10px;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-top: 12px;
                            padding-bottom: 12px;
                            alignment: space-between;

                            Text {
                                text: "启动前检测代理端口连通性";
                                font-size: 13.5px;
                                color: Theme.text;
                                vertical-alignment: center;
                            }

                            VerticalLayout {
                                alignment: center;
                                SegmentedBoolToggle {
                                    checked <=> root.check-proxy-before-launch;
                                    toggled(val) => { root.set-check-proxy-before-launch(val); }
                                }
                            }
                        }
                    }

                    Rectangle {
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.line;
                        border-radius: 10px;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-top: 12px;
                            padding-bottom: 12px;
                            alignment: space-between;

                            Text {
                                text: "配置文件";
                                font-size: 13.5px;
                                color: Theme.text;
                                vertical-alignment: center;
                            }

                            Text {
                                text: root.config-path;
                                font-size: 12px;
                                color: Theme.secondary;
                                vertical-alignment: center;
                            }
                        }
                    }
                    }
                }
            }

            // === Bottom Status Toast ===
            if root.toast-text != "" : Rectangle {
                height: 34px;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.line;

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 14px;
                    alignment: space-between;

                    Text {
                        text: root.toast-text;
                        font-size: 12px;
                        color: root.toast-is-error ? Theme.negative : Theme.positive;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        alignment: center;
                        TextLink {
                            label: "关闭";
                            text-color: Theme.muted;
                            clicked => { root.toast-text = ""; }
                        }
                    }
                }
            }
        }

        // === Frameless Window Edge Resize Handles (Windows / Linux; macOS uses native window resize) ===
        if !root.is-maximized && !root.is-macos : TouchArea {
            x: 6px; y: 0px; width: parent.width - 12px; height: 4px;
            mouse-cursor: ns-resize;
            pointer-event(ev) => {
                if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) { root.resize-window(0); }
            }
        }
        if !root.is-maximized && !root.is-macos : TouchArea {
            x: 6px; y: parent.height - 4px; width: parent.width - 12px; height: 4px;
            mouse-cursor: ns-resize;
            pointer-event(ev) => {
                if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) { root.resize-window(1); }
            }
        }
        if !root.is-maximized && !root.is-macos : TouchArea {
            x: 0px; y: 6px; width: 4px; height: parent.height - 12px;
            mouse-cursor: ew-resize;
            pointer-event(ev) => {
                if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) { root.resize-window(2); }
            }
        }
        if !root.is-maximized && !root.is-macos : TouchArea {
            x: parent.width - 4px; y: 6px; width: 4px; height: parent.height - 12px;
            mouse-cursor: ew-resize;
            pointer-event(ev) => {
                if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) { root.resize-window(3); }
            }
        }
        if !root.is-maximized && !root.is-macos : TouchArea {
            x: 0px; y: 0px; width: 6px; height: 6px;
            mouse-cursor: nwse-resize;
            pointer-event(ev) => {
                if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) { root.resize-window(4); }
            }
        }
        if !root.is-maximized && !root.is-macos : TouchArea {
            x: parent.width - 6px; y: 0px; width: 6px; height: 6px;
            mouse-cursor: nesw-resize;
            pointer-event(ev) => {
                if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) { root.resize-window(5); }
            }
        }
        if !root.is-maximized && !root.is-macos : TouchArea {
            x: 0px; y: parent.height - 6px; width: 6px; height: 6px;
            mouse-cursor: nesw-resize;
            pointer-event(ev) => {
                if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) { root.resize-window(6); }
            }
        }
        if !root.is-maximized && !root.is-macos : TouchArea {
            x: parent.width - 6px; y: parent.height - 6px; width: 6px; height: 6px;
            mouse-cursor: nwse-resize;
            pointer-event(ev) => {
                if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) { root.resize-window(7); }
            }
        }
    }
}
